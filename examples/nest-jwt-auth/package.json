{
  "name": "nest-jwt-auth",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS 12 JWT authentication: @nestjs/jwt, a passport-jwt strategy pinned to HS256, a @Roles() decorator with a RolesGuard, and node:crypto scrypt password hashing.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm run build",
    "start": "node dist/main.js",
    "test": "node --test",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
