{
  "name": "nest-typeorm",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS 12 with @nestjs/typeorm 12 and TypeORM 1.1 over SQLite: entities, a relation, repository injection, a transaction and parameterised queries only.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm run build",
    "seed": "node dist/seed.js",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "typeorm": {
      "better-sqlite3": "^13.0.3"
    }
  }
}