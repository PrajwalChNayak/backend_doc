{
  "name": "nest-esm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal NestJS 12 app as a pure-ESM project: type module, nodenext resolution, .js relative imports, and import.meta.dirname.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm run build",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
