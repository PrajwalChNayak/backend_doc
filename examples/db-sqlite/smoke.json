{
  "port": 3010,
  "entry": "src/server.js",
  "requiresService": false,
  "requests": [
    {
      "method": "GET",
      "path": "/health",
      "expect": 200
    },
    {
      "method": "GET",
      "path": "/node-sqlite/users",
      "expect": 200
    },
    {
      "method": "GET",
      "path": "/node-sqlite/users/1",
      "expect": 200
    },
    {
      "method": "GET",
      "path": "/node-sqlite/users/1/posts",
      "expect": 200
    },
    {
      "method": "GET",
      "path": "/node-sqlite/users?sort=name&direction=desc&limit=2",
