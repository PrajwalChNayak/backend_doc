{
  "name": "orm-prisma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma 7 over SQLite from Express 5: schema, migrations, seed, relation queries with include, an interactive transaction, and the $queryRaw tagged-template escape hatch.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "setup": "prisma migrate deploy && prisma generate",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3"
  }
}
