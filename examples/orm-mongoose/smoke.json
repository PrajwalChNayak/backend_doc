{
  "port": 3024,
  "entry": "src/server.js",
  "requiresService": true,
  "requests": [
    { "method": "GET", "path": "/health", "expect": 200 },
    { "method": "GET", "path": "/users", "expect": 200 },
    { "method": "GET", "path": "/posts", "expect": 200 },
    { "method": "GET", "path": "/stats/authors?minPosts=1", "expect": 200 },
    { "method": "POST", "path": "/users", "body": { "email": "smoke-mongoose@example.com", "name": "Smoke" }, "expect": [201, 409] },
    { "method": "POST", "path": "/users/search", "body": { "email": "ada@example.com" }, "expect": 200 },
    { "method": "POST", "path": "/users/search", "body": { "email": { "$ne": null } }, "expect": 400 },
    { "method": "POST", "path": "/users-with-posts", "body": { "email": "smoke-mongoose-tx@example.com", "name": "Smoke Tx", "posts": [{ "title": "One" }, { "title": "Two", "body": "b" }] }, "expect": [201, 409, 501] },
    { "method": "GET", "path": "/users?sort=nope", "expect": 400 },
    { "method": "GET", "path": "/no-such-route", "expect": 404 }
  ]
}
