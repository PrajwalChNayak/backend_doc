# --- Node/Express handbook -------------------------------------------------
# docs/ is the generated site and IS committed — GitHub Pages serves it.
# Example runtime artefacts are not.
examples/**/node_modules
examples/**/*.sqlite
examples/**/*.sqlite3
examples/**/*.db
examples/**/data/
# Runtime upload storage only. This deliberately does NOT match a source
# directory named `uploads` — an earlier `examples/**/uploads/` silently
# ignored `src/uploads/`, so a whole source folder never got committed.
examples/*/uploads/
examples/*/tmp/uploads/
examples/**/.env
.env
